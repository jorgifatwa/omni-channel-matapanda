# ==========================================
# DATABASE (PostgreSQL + Prisma)
# ==========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/matapanda_db?schema=public"

# ==========================================
# DOMAIN & NEXTAUTH CONFIGURATION
# ==========================================
# Di lokal development: http://localhost:3000 (atau http://localhost:3001)
# Di production Vercel: masukkan domain live Anda (contoh: https://itsmypanda.my.id)
NEXTAUTH_URL="https://itsmypanda.my.id"
NEXT_PUBLIC_APP_URL="https://itsmypanda.my.id"
NEXTAUTH_SECRET="matapanda-super-secret-jwt-key-change-in-production-2026"
ADMIN_DEFAULT_EMAIL="admin@itsmatapanda.com"
ADMIN_DEFAULT_PASSWORD="admin-password-change-me"
E2E_TEST_ADMIN_EMAIL="e2e-test-admin@itsmatapanda.test"
E2E_TEST_ADMIN_PASSWORD="e2e-test-password-placeholder"

# ==========================================
# CLOUDFLARE R2 (Primary Image Storage - S3 Compatible, Zero Egress)
# ==========================================
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="matapanda-images"
R2_PUBLIC_URL="https://pub-your-bucket-id.r2.dev"

# ==========================================
# RAJAONGKIR (Domestic Indonesia Shipping - JNE / POS / TIKI)
# ==========================================
RAJAONGKIR_API_KEY="your-rajaongkir-api-key"
RAJAONGKIR_ORIGIN_CITY_ID="23" # 23 = Kota Bandung (Kiara Condong Origin)

# ==========================================
# CLOUDINARY (Secondary Fallback Image Upload)
# ==========================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_UPLOAD_PRESET="matapanda_unsigned"

# ==========================================
# MIDTRANS PAYMENT GATEWAY (Sandbox / Production)
# ==========================================
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_MERCHANT_ID="G123456789"
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"

# ==========================================
# SHIPPING GATEWAY — JNE (Domestic Indonesia)
# ==========================================
JNE_API_BASE_URL="https://apiv2.jne.co.id:10205"
JNE_USERNAME="MATAPANDABDO"
JNE_API_KEY="your-jne-api-key"
JNE_ORIGIN_CODE="BDO10000"

# ==========================================
# SHIPPING GATEWAY — DHL EXPRESS (International)
# ==========================================
DHL_API_BASE_URL="https://express.api.dhl.com/mydhlapi/test"
DHL_API_KEY="your-dhl-api-key"
DHL_API_SECRET="your-dhl-api-secret"
DHL_ACCOUNT_NUMBER="123456789"

# ==========================================
# EMAIL NOTIFICATIONS (Nodemailer SMTP / Gmail)
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="toko.matapanda@gmail.com"
SMTP_PASSWORD="xxxx xxxx xxxx xxxx" # 16-digit Google App Password
SMTP_FROM="it's matapanda Jakarta <orders@itsmatapanda.com>"

# ==========================================
# MARKETPLACE INTEGRATION — Shopee Open Platform
# Daftar partner di: https://open.shopee.com
# ==========================================
SHOPEE_PARTNER_ID="your-shopee-partner-id"
SHOPEE_PARTNER_KEY="your-shopee-partner-key"
SHOPEE_REDIRECT_URI="http://localhost:3000/api/integrations/shopee/callback"
# Set to "true" for testing on Shopee test environment
SHOPEE_SANDBOX="true"

# ==========================================
# MARKETPLACE INTEGRATION — TikTok Shop Partner Center (Tokopedia)
# Daftar partner di: https://partner.tiktokshop.com
# (Mencakup Tokopedia & TikTok Shop pasca merger)
# ==========================================
TIKTOK_SHOP_APP_KEY="your-tiktok-shop-app-key"
TIKTOK_SHOP_APP_SECRET="your-tiktok-shop-app-secret"
TIKTOK_SHOP_SERVICE_ID="your-tiktok-shop-service-id"
TIKTOK_SHOP_REDIRECT_URI="http://localhost:3000/api/integrations/tiktokshop/callback"

# ==========================================
# MARKETPLACE TOKEN ENCRYPTION
# 32-byte hexadecimal string (64 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==========================================
MARKETPLACE_ENCRYPTION_KEY="your-64-character-hex-encryption-key"

# ==========================================
# CRON JOB SECRET (untuk /api/integrations/refresh-tokens)
# ==========================================
CRON_SECRET="your-secure-random-cron-secret"

